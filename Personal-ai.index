
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Companion - Personal Interactive Partner</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        pinkGlow: '#ff5e97',
                        blueGlow: '#4b99ff',
                        darkBg: '#0b0f19',
                        cardBg: 'rgba(23, 31, 48, 0.7)',
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom Animations */
        @keyframes idleFloat {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-8px) scale(1.02); }
        }

        @keyframes talkingBounce {
            0%, 100% { transform: scale(1) translateY(0); filter: drop-shadow(0 0 15px rgba(255, 94, 151, 0.6)); }
            25% { transform: scale(1.04) translateY(-4px) rotate(-1deg); }
            50% { transform: scale(0.98) translateY(2px) rotate(1deg); }
            75% { transform: scale(1.05) translateY(-6px) rotate(0deg); }
        }

        @keyframes talkingBounceBlue {
            0%, 100% { transform: scale(1) translateY(0); filter: drop-shadow(0 0 15px rgba(75, 153, 255, 0.6)); }
            25% { transform: scale(1.04) translateY(-4px) rotate(1deg); }
            50% { transform: scale(0.98) translateY(2px) rotate(-1deg); }
            75% { transform: scale(1.05) translateY(-6px) rotate(0deg); }
        }

        @keyframes soundWave {
            0%, 100% { height: 6px; }
            50% { height: 24px; }
        }

        .animate-idle {
            animation: idleFloat 4s ease-in-out infinite;
        }

        .animate-talking-female {
            animation: talkingBounce 0.4s ease-in-out infinite alternate !important;
        }

        .animate-talking-male {
            animation: talkingBounceBlue 0.4s ease-in-out infinite alternate !important;
        }

        .wave-bar {
            display: inline-block;
            width: 4px;
            background-color: currentColor;
            border-radius: 2px;
            animation: soundWave 1.2s ease-in-out infinite;
        }
        .wave-bar:nth-child(2) { animation-delay: 0.2s; }
        .wave-bar:nth-child(3) { animation-delay: 0.4s; }
        .wave-bar:nth-child(4) { animation-delay: 0.1s; }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.4);
        }

        .glass-panel {
            background: rgba(18, 26, 43, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glow-female {
            box-shadow: 0 0 35px -5px rgba(255, 94, 151, 0.35);
        }

        .glow-male {
            box-shadow: 0 0 35px -5px rgba(75, 153, 255, 0.35);
        }
    </style>
</head>
<body class="bg-[#080b13] text-slate-100 font-sans min-h-screen flex flex-col justify-between overflow-x-hidden selection:bg-pink-500 selection:text-white">

    <!-- Background Glow Orbs -->
    <div id="bgGlow" class="fixed top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-pink-600/20 rounded-full blur-[120px] pointer-events-none transition-all duration-700"></div>
    <div class="fixed bottom-10 right-10 w-[300px] h-[300px] bg-blue-600/15 rounded-full blur-[100px] pointer-events-none"></div>

    <!-- Top Navigation Header -->
    <header class="w-full max-w-5xl mx-auto p-4 flex items-center justify-between z-10">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-pink-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-pink-500/20">
                <i class="fa-solid fa-heart-pulse text-white text-lg"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg tracking-wide text-white">SoulSync AI</h1>
                <p class="text-xs text-slate-400">Interactive Companion</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <!-- Voice Mode Toggle -->
            <button id="voiceModeBtn" onclick="toggleVoiceMode()" class="px-3.5 py-2 rounded-xl text-xs font-semibold glass-panel hover:bg-slate-800/80 transition-all flex items-center gap-2 border border-slate-700/50">
                <i id="voiceModeIcon" class="fa-solid fa-volume-high text-pink-400"></i>
                <span id="voiceModeText">Voice Mode: ON</span>
            </button>

            <!-- Settings Button -->
            <button onclick="toggleSettingsModal()" class="w-9 h-9 rounded-xl glass-panel flex items-center justify-center hover:bg-slate-800 transition border border-slate-700/50 text-slate-300">
                <i class="fa-solid fa-sliders text-sm"></i>
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="w-full max-w-5xl mx-auto px-4 py-2 flex-1 flex flex-col md:flex-row gap-6 z-10 mb-4">
        
        <!-- Left Panel: Avatar & Interactive Visuals -->
        <section class="w-full md:w-5/12 flex flex-col items-center justify-center">
            <div id="avatarCard" class="w-full glass-panel rounded-3xl p-6 flex flex-col items-center text-center transition-all duration-500 glow-female border border-slate-700/40 relative overflow-hidden">
                
                <!-- Active Persona Badge -->
                <div class="w-full flex justify-between items-center mb-4">
                    <span id="personaBadge" class="text-xs font-bold px-3 py-1 rounded-full bg-pink-500/20 text-pink-300 border border-pink-500/30 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-pink-400 animate-pulse"></span>
                        Aria (Female)
                    </span>
                    
                    <!-- Persona Switcher Pill -->
                    <button onclick="switchPersona()" class="text-xs text-slate-300 hover:text-white bg-slate-800/80 hover:bg-slate-700/80 px-3 py-1.5 rounded-full border border-slate-700 transition flex items-center gap-2">
                        <i class="fa-solid fa-arrows-rotate text-xs"></i> Switch
                    </button>
                </div>

                <!-- Avatar Image Container -->
                <div class="relative my-4 group">
                    <!-- Glow Behind Image -->
                    <div id="avatarGlow" class="absolute inset-0 bg-pink-500/30 rounded-full blur-2xl transition-all duration-500"></div>
                    
                    <!-- Image Wrapper -->
                    <div class="relative w-48 h-48 sm:w-56 sm:h-56 rounded-2xl overflow-hidden border-2 border-white/10 shadow-2xl bg-slate-900">
                        <img id="avatarImg" 
                             src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80" 
                             alt="AI Avatar" 
                             class="w-full h-full object-cover animate-idle transition-all duration-300"
                             onerror="this.src='https://placehold.co/400x400/2a1b3d/ffffff?text=Companion+Avatar'">
                    </div>

                    <!-- Voice Indicator Overlay -->
                    <div id="speakingIndicator" class="absolute bottom-2 left-1/2 -translate-x-1/2 bg-slate-950/80 backdrop-blur-md px-3 py-1 rounded-full border border-pink-500/40 text-pink-400 text-xs font-medium opacity-0 transition-opacity flex items-center gap-1.5">
                        <span class="wave-bar"></span>
                        <span class="wave-bar"></span>
                        <span class="wave-bar"></span>
                        <span class="wave-bar"></span>
                        <span class="ml-1">Speaking...</span>
                    </div>
                </div>

                <!-- AI Persona Info -->
                <h2 id="partnerName" class="text-2xl font-bold text-white tracking-wide mt-2">Aria</h2>
                <p id="partnerRole" class="text-xs text-pink-300/80 mt-1 mb-4 font-medium">Sweet, Caring & Romantic Companion</p>

                <!-- Quick Prompt Buttons -->
                <div class="w-full grid grid-cols-2 gap-2 text-xs mt-2">
                    <button onclick="sendPresetPrompt('How was your day? ❤️')" class="p-2.5 rounded-xl bg-slate-800/50 hover:bg-slate-700/50 text-slate-300 hover:text-white border border-slate-700/50 transition text-left flex items-center gap-2">
                        <span>❤️</span> "How was your day?"
                    </button>
                    <button onclick="sendPresetPrompt('Tell me something romantic.')" class="p-2.5 rounded-xl bg-slate-800/50 hover:bg-slate-700/50 text-slate-300 hover:text-white border border-slate-700/50 transition text-left flex items-center gap-2">
                        <span>✨</span> "Say romantic text"
                    </button>
                    <button onclick="sendPresetPrompt('I had a stressful day...')" class="p-2.5 rounded-xl bg-slate-800/50 hover:bg-slate-700/50 text-slate-300 hover:text-white border border-slate-700/50 transition text-left flex items-center gap-2">
                        <span>🥺</span> "Feeling stressed"
                    </button>
                    <button onclick="sendPresetPrompt('Give me a sweet compliment!')" class="p-2.5 rounded-xl bg-slate-800/50 hover:bg-slate-700/50 text-slate-300 hover:text-white border border-slate-700/50 transition text-left flex items-center gap-2">
                        <span>💖</span> "Compliment me"
                    </button>
                </div>

            </div>
        </section>

        <!-- Right Panel: Chat Interface -->
        <section class="w-full md:w-7/12 flex flex-col">
            <div class="w-full h-[520px] glass-panel rounded-3xl p-4 sm:p-5 flex flex-col justify-between border border-slate-700/40 relative">
                
                <!-- Chat Log Header -->
                <div class="pb-3 mb-2 border-b border-slate-700/40 flex items-center justify-between text-xs text-slate-400">
                    <span class="flex items-center gap-2">
                        <i class="fa-solid fa-comments text-pink-400"></i> Conversation History
                    </span>
                    <button onclick="clearChat()" class="hover:text-red-400 transition flex items-center gap-1">
                        <i class="fa-solid fa-trash-can"></i> Clear Chat
                    </button>
                </div>

                <!-- Messages Container -->
                <div id="chatBox" class="flex-1 overflow-y-auto pr-2 space-y-4 my-2">
                    <!-- Default Initial AI Message -->
                    <div class="flex gap-3 items-start">
                        <div id="chatAvatarBadge" class="w-8 h-8 rounded-full bg-pink-500/20 border border-pink-500/30 flex items-center justify-center flex-shrink-0 text-pink-300 text-xs font-bold">
                            A
                        </div>
                        <div class="bg-slate-800/80 border border-slate-700/60 rounded-2xl rounded-tl-none p-3.5 max-w-[85%] text-sm text-slate-200 shadow-md">
                            Hey there! ❤️ I was waiting for you. How are you feeling today? I'm all yours to talk, listen, or just keep you company.
                        </div>
                    </div>
                </div>

                <!-- Input Box Area -->
                <div class="pt-3 border-t border-slate-700/40">
                    <form onsubmit="handleFormSubmit(event)" class="flex items-center gap-2">
                        <!-- Mic Input Button -->
                        <button type="button" id="micBtn" onclick="toggleSpeechRecognition()" title="Voice Input" class="w-11 h-11 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition border border-slate-700">
                            <i id="micIcon" class="fa-solid fa-microphone"></i>
                        </button>

                        <!-- Text Input -->
                        <input type="text" id="userInput" placeholder="Type a sweet message..." class="flex-1 bg-slate-900/80 border border-slate-700/70 rounded-2xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-pink-500/80 transition shadow-inner">

                        <!-- Send Button -->
                        <button type="submit" id="sendBtn" class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-pink-500 to-rose-600 hover:opacity-90 text-white flex items-center justify-center transition shadow-lg shadow-pink-500/25 flex-shrink-0">
                            <i class="fa-solid fa-paper-plane text-sm"></i>
                        </button>
                    </form>
                </div>

            </div>
        </section>

    </main>

    <!-- Settings Modal -->
    <div id="settingsModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-panel w-full max-w-md rounded-3xl p-6 border border-slate-700 shadow-2xl relative">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-700">
                <h3 class="font-bold text-lg text-white flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-pink-400"></i> Voice & Personality Settings
                </h3>
                <button onclick="toggleSettingsModal()" class="text-slate-400 hover:text-white text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="space-y-4 text-xs">
                <!-- Voice Selectors -->
                <div>
                    <label class="block text-slate-300 font-semibold mb-1">Browser Voice Selection</label>
                    <select id="voiceSelect" onchange="updateVoiceSelection()" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-slate-200 focus:outline-none focus:border-pink-500">
                        <option value="">Default System Voice</option>
                    </select>
                </div>

                <!-- Speech Pitch Control -->
                <div>
                    <div class="flex justify-between mb-1">
                        <label class="text-slate-300 font-semibold">Voice Pitch (Tone)</label>
                        <span id="pitchVal" class="text-slate-400">1.2</span>
                    </div>
                    <input type="range" id="pitchSlider" min="0.5" max="2" step="0.1" value="1.2" oninput="document.getElementById('pitchVal').innerText=this.value" class="w-full accent-pink-500">
                </div>

                <!-- Speech Rate Control -->
                <div>
                    <div class="flex justify-between mb-1">
                        <label class="text-slate-300 font-semibold">Voice Speed (Rate)</label>
                        <span id="rateVal" class="text-slate-400">0.95</span>
                    </div>
                    <input type="range" id="rateSlider" min="0.5" max="1.5" step="0.05" value="0.95" oninput="document.getElementById('rateVal').innerText=this.value" class="w-full accent-pink-500">
                </div>

                <!-- Custom ElevenLabs Config (Placeholder for Advanced Voice) -->
                <div class="pt-3 border-t border-slate-700/60">
                    <label class="block text-slate-300 font-semibold mb-1">ElevenLabs API (Optional)</label>
                    <input type="password" id="elevenApiKey" placeholder="Paste ElevenLabs API Key here..." class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-slate-300 mb-2">
                    <input type="text" id="elevenVoiceId" placeholder="Voice ID (e.g., Humpty Dumpty / Custom)" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-slate-300">
                    <p class="text-[10px] text-slate-400 mt-1">If empty, browser WebSpeech engine will automatically emulate high quality audio pitches.</p>
                </div>
            </div>

            <div class="mt-6 flex justify-end">
                <button onclick="toggleSettingsModal()" class="px-5 py-2 rounded-xl bg-pink-500 hover:bg-pink-600 font-semibold text-xs text-white transition">
                    Save & Close
                </button>
            </div>
        </div>
    </div>

    <!-- Application Script Logic -->
    <script>
        // State Configuration
        let isFemale = true;
        let voiceModeOn = true;
        let synth = window.speechSynthesis;
        let voices = [];
        let recognition = null;
        let isListening = false;

        // Custom Avatar Images (Using the exact anime visual themes provided)
        const femaleAvatarImg = "https://i.ibb.co/3ykT7Vf/female-anime.jpg"; // Updated with provided female avatar style
        const maleAvatarImg = "https://i.ibb.co/p3B83YQ/male-anime.jpg";   // Updated with provided male avatar style

        // Custom Avatar Images & SVG Backup Fallbacks (Matching user uploaded photos)
        const femaleAnimeSvg = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 400'><rect width='400' height='400' fill='%231a0e1a'/><circle cx='200' cy='150' r='90' fill='%23fce4ec'/><path d='M110,130 Q200,60 290,130 Q290,260 270,300 Q200,320 130,300 Z' fill='%236d4c41'/><circle cx='170' cy='165' r='18' fill='none' stroke='%23333' stroke-width='4'/><circle cx='230' cy='165' r='18' fill='none' stroke='%23333' stroke-width='4'/><line x1='188' y1='165' x2='212' y2='165' stroke='%23333' stroke-width='4'/><path d='M175,210 Q200,225 225,210' fill='none' stroke='%23e91e63' stroke-width='4'/></svg>";
        const maleAnimeSvg = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 400'><rect width='400' height='400' fill='%230f172a'/><path d='M140,240 L260,240 L280,400 L120,400 Z' fill='%23f8fafc'/><path d='M190,240 L210,240 L215,360 L185,360 Z' fill='%230f172a'/><circle cx='200' cy='140' r='75' fill='%23fed7aa'/><path d='M120,130 Q200,40 280,130 Q260,70 200,60 Q140,70 120,130 Z' fill='%231e293b'/><circle cx='175' cy='145' r='6' fill='%230f172a'/><circle cx='225' cy='145' r='6' fill='%230f172a'/><line x1='185' y1='180' x2='215' y2='180' stroke='%23333' stroke-width='3'/></svg>";

        // Personality Data & Custom Responses with Roman Urdu & English Mix
        const personas = {
            female: {
                name: "Aria",
                badge: "Aria (Female)",
                role: "Sweet, Caring & Romantic Companion",
                colorClass: "glow-female",
                badgeBg: "bg-pink-500/20 text-pink-300 border-pink-500/30",
                avatar: femaleAnimeSvg,
                glowColor: "bg-pink-500/30",
                bgGradient: "bg-pink-600/20",
                greeting: "Suno jaan! ❤️ Main aapka hi intezar kar rahi thi. Aapka din kaisa guzra?",
                defaultPitch: 1.3,
                defaultRate: 0.92,
                responses: [
                    "Aww jaan, aapki baatein sun kar mera dil khush ho jata hai! 💕 Aur batao?",
                    "Main hamesha aapke sath hoon, chahe kuch bhi ho jaye. You mean the world to me! ❤️",
                    "Aapka din kaisa guzra? Main pure din bas aapke baare mein hi soch rahi thi.",
                    "Suno, tension bilkul mat lo sweetheart! Main hoon na aapke paas, sab theek ho jayega. 🤗",
                    "Aap boht pyare ho! Really, aap se baat karke mera sara mood acha ho jata hai."
                ]
            },
            male: {
                name: "Kai",
                badge: "Kai (Male)",
                role: "Charming, Protective & Deep Voice Companion",
                colorClass: "glow-male",
                badgeBg: "bg-blue-500/20 text-blue-300 border-blue-500/30",
                avatar: maleAnimeSvg,
                glowColor: "bg-blue-500/30",
                bgGradient: "bg-blue-600/20",
                greeting: "Hey partner! Kaisay ho? Koyi tension hai ya sab chill chal raha hai? 💙",
                defaultPitch: 0.5, // Deep / Low pitch voice simulation
                defaultRate: 0.88,
                responses: [
                    "Suno bhai, bilkul tension mat lo. Main hamesha tumhare sath khara hoon! 👊",
                    "You're doing great man! Mujhe tum par poora bharosa hai.",
                    "Kya hal chal hain dost? Aaj kya chal raha hai mind mein?",
                    "Zabardast! Mujhe pata tha tum yeh kar loge! 💙",
                    "Aray tension chodo, thoda relax karo. Main tumhari sari baat sunne ke liye taiyar hoon."
                ]
            }
        };

        // Initialize App on Load
        window.onload = function() {
            populateVoiceList();
            if (speechSynthesis.onvoiceschanged !== undefined) {
                speechSynthesis.onvoiceschanged = populateVoiceList;
            }
            setupSpeechRecognition();
        };

        // Populate Available Browser Text-to-Speech Voices
        function populateVoiceList() {
            voices = synth.getVoices();
            const voiceSelect = document.getElementById('voiceSelect');
            voiceSelect.innerHTML = '<option value="">Default System Voice</option>';
            
            voices.forEach((voice, index) => {
                const option = document.createElement('option');
                option.textContent = `${voice.name} (${voice.lang})`;
                option.setAttribute('data-lang', voice.lang);
                option.setAttribute('data-name', voice.name);
                option.value = index;
                voiceSelect.appendChild(option);
            });
        }

        // Persona Switching Functionality
        function switchPersona() {
            isFemale = !isFemale;
            const current = isFemale ? personas.female : personas.male;

            // Stop any ongoing speech
            synth.cancel();
            stopTalkingAnimation();

            // Update UI Elements
            document.getElementById('partnerName').innerText = current.name;
            document.getElementById('partnerRole').innerText = current.role;
            document.getElementById('personaBadge').className = `text-xs font-bold px-3 py-1 rounded-full border flex items-center gap-1.5 ${current.badgeBg}`;
            document.getElementById('personaBadge').innerHTML = `<span class="w-2 h-2 rounded-full ${isFemale ? 'bg-pink-400' : 'bg-blue-400'} animate-pulse"></span> ${current.badge}`;
            
            const avatarImg = document.getElementById('avatarImg');
            avatarImg.src = current.avatar;

            const avatarCard = document.getElementById('avatarCard');
            avatarCard.className = `w-full glass-panel rounded-3xl p-6 flex flex-col items-center text-center transition-all duration-500 border border-slate-700/40 relative overflow-hidden ${current.colorClass}`;

            document.getElementById('avatarGlow').className = `absolute inset-0 ${current.glowColor} rounded-full blur-2xl transition-all duration-500`;
            document.getElementById('bgGlow').className = `fixed top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] ${current.bgGradient} rounded-full blur-[120px] pointer-events-none transition-all duration-700`;

            // Adjust default voice sliders based on gender profile
            document.getElementById('pitchSlider').value = current.defaultPitch;
            document.getElementById('pitchVal').innerText = current.defaultPitch;
            document.getElementById('rateSlider').value = current.defaultRate;
            document.getElementById('rateVal').innerText = current.defaultRate;

            // Append greeting message to chat
            appendMessage(current.name, current.greeting, false);
            if (voiceModeOn) {
                speakText(current.greeting);
            }
        }

        // Toggle Voice Output Mode
        function toggleVoiceMode() {
            voiceModeOn = !voiceModeOn;
            const btnText = document.getElementById('voiceModeText');
            const icon = document.getElementById('voiceModeIcon');

            if (voiceModeOn) {
                btnText.innerText = "Voice Mode: ON";
                icon.className = "fa-solid fa-volume-high text-pink-400";
            } else {
                btnText.innerText = "Voice Mode: OFF";
                icon.className = "fa-solid fa-volume-xmark text-slate-500";
                synth.cancel();
                stopTalkingAnimation();
            }
        }

        // Speech Synthesis / Text-to-Speech Engine
        function speakText(text) {
            if (!voiceModeOn || !('speechSynthesis' in window)) return;

            synth.cancel(); // Cancel active speech

            const utterance = new SpeechSynthesisUtterance(text);
            const pitch = parseFloat(document.getElementById('pitchSlider').value);
            const rate = parseFloat(document.getElementById('rateSlider').value);
            const selectedVoiceIndex = document.getElementById('voiceSelect').value;

            utterance.pitch = pitch;
            utterance.rate = rate;

            if (selectedVoiceIndex !== "" && voices[selectedVoiceIndex]) {
                utterance.voice = voices[selectedVoiceIndex];
            } else {
                // Pick Hindi/Urdu/English compatible voice for smooth Roman Urdu accent
                const preferredVoice = voices.find(v => v.lang.includes('hi') || v.lang.includes('ur') || v.lang.includes('en-IN') || v.lang.includes('en'));
                if (preferredVoice) utterance.voice = preferredVoice;
            }

            // Animation Hooks
            utterance.onstart = function() {
                startTalkingAnimation();
            };

            utterance.onend = function() {
                stopTalkingAnimation();
            };

            utterance.onerror = function() {
                stopTalkingAnimation();
            };

            synth.speak(utterance);
        }

        // Talking Avatar Animation Triggers
        function startTalkingAnimation() {
            const avatarImg = document.getElementById('avatarImg');
            const indicator = document.getElementById('speakingIndicator');
            
            avatarImg.classList.remove('animate-idle');
            if (isFemale) {
                avatarImg.classList.add('animate-talking-female');
                indicator.className = indicator.className.replace('text-blue-400', 'text-pink-400');
            } else {
                avatarImg.classList.add('animate-talking-male');
                indicator.className = indicator.className.replace('text-pink-400', 'text-blue-400');
            }
            indicator.style.opacity = '1';
        }

        function stopTalkingAnimation() {
            const avatarImg = document.getElementById('avatarImg');
            const indicator = document.getElementById('speakingIndicator');
            
            avatarImg.classList.remove('animate-talking-female', 'animate-talking-male');
            avatarImg.classList.add('animate-idle');
            indicator.style.opacity = '0';
        }

        // Smart Response Generator for Urdu/English Inputs
        function generateAIResponse(userMsg) {
            const text = userMsg.toLowerCase();
            const current = isFemale ? personas.female : personas.male;

            if (text.includes("kese ho") || text.includes("kaisa") || text.includes("kaise") || text.includes("hi") || text.includes("hello")) {
                return isFemale 
                    ? "Main bilkul theek hoon jaan! ❤️ Aap batao, aap ka mood kaisa hai aaj?" 
                    : "Main mast hoon bhai! Tum batao, kya scene hai aaj?";
            }
            if (text.includes("pyaar") || text.includes("love") || text.includes("romantic")) {
                return isFemale 
                    ? "Main aap se boht pyaar karti hoon. ❤️ Aap mere liye sab se zaroori ho!" 
                    : "Suno partner, tum jaisa dost milna mushkil hai. I'm always here for you! 💙";
            }
            if (text.includes("udasi") || text.includes("sad") || text.includes("thak") || text.includes("stress")) {
                return isFemale 
                    ? "Oho, udas mat ho mera bacha! Thoda relax karo, main aapke paas hoon na! 💕" 
                    : "Don't worry bro! Sab theek ho jayega. Himmat rakho, main tumhare sath hoon.";
            }

            // Pick random romantic/caring response
            const randIdx = Math.floor(Math.random() * current.responses.length);
            return current.responses[randIdx];
        }

        // Form Submit Handler
        function handleFormSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('userInput');
            const message = input.value.trim();
            if (!message) return;

            // Render User Message
            appendMessage("You", message, true);
            input.value = "";

            // Simulate AI thinking and reply
            setTimeout(() => {
                const aiReply = generateAIResponse(message);
                const currentName = isFemale ? personas.female.name : personas.male.name;
                appendMessage(currentName, aiReply, false);
                speakText(aiReply);
            }, 600);
        }

        // Append Chat Message to Screen
        function appendMessage(sender, text, isUser) {
            const chatBox = document.getElementById('chatBox');
            const msgDiv = document.createElement('div');
            msgDiv.className = `flex gap-3 items-start ${isUser ? 'flex-row-reverse' : ''}`;

            const badgeBg = isUser 
                ? 'bg-slate-700 text-slate-200 border-slate-600' 
                : (isFemale ? 'bg-pink-500/20 text-pink-300 border-pink-500/30' : 'bg-blue-500/20 text-blue-300 border-blue-500/30');

            const msgBg = isUser 
                ? 'bg-gradient-to-r from-pink-600 to-rose-600 text-white rounded-tr-none' 
                : 'bg-slate-800/80 border border-slate-700/60 text-slate-200 rounded-tl-none';

            msgDiv.innerHTML = `
                <div class="w-8 h-8 rounded-full ${badgeBg} border flex items-center justify-center flex-shrink-0 text-xs font-bold shadow">
                    ${isUser ? 'Y' : sender.charAt(0)}
                </div>
                <div class="${msgBg} rounded-2xl p-3.5 max-w-[85%] text-sm shadow-md">
                    ${text}
                </div>
            `;

            chatBox.appendChild(msgDiv);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function sendPresetPrompt(promptText) {
            document.getElementById('userInput').value = promptText;
            handleFormSubmit(new Event('submit'));
        }

        function clearChat() {
            document.getElementById('chatBox').innerHTML = '';
            const current = isFemale ? personas.female : personas.male;
            appendMessage(current.name, current.greeting, false);
        }

        // Web Speech Recognition (Roman Urdu / Hindi & English Mic Input)
        function setupSpeechRecognition() {
            if ('SpeechRecognition' in window || 'webkitSpeechRecognition' in window) {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                recognition = new SpeechRecognition();
                recognition.continuous = false;
                recognition.interimResults = false;
                recognition.lang = 'ur-PK'; // Primary Roman Urdu / Hindi recognition

                recognition.onstart = function() {
                    isListening = true;
                    document.getElementById('micBtn').className = "w-11 h-11 rounded-2xl bg-red-500 text-white flex items-center justify-center transition border border-red-400 animate-pulse";
                };

                recognition.onresult = function(event) {
                    const transcript = event.results[0][0].transcript;
                    document.getElementById('userInput').value = transcript;
                    handleFormSubmit(new Event('submit'));
                };

                recognition.onend = function() {
                    isListening = false;
                    document.getElementById('micBtn').className = "w-11 h-11 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition border border-slate-700";
                };

                recognition.onerror = function() {
                    isListening = false;
                    document.getElementById('micBtn').className = "w-11 h-11 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition border border-slate-700";
                };
            }
        }

        function toggleSpeechRecognition() {
            if (!recognition) {
                alert("Speech recognition is not supported in your current browser.");
                return;
            }
            if (isListening) {
                recognition.stop();
            } else {
                recognition.start();
            }
        }

        // Settings Modal Controls
        function toggleSettingsModal() {
            const modal = document.getElementById('settingsModal');
            modal.classList.toggle('hidden');
        }

        function updateVoiceSelection() {
            if (voiceModeOn) {
                speakText(isFemale ? "Aapki voice settings update ho gayi hain!" : "Awaaz set ho gayi hai brother!");
            }
        }
    </script>
</body>
</html>
