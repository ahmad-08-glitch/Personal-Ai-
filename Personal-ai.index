<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Companion - Roman Urdu Voice & Custom Avatars</title>
    <style>
        :root {
            --bg-color: #0d1117;
            --card-bg: rgba(22, 27, 34, 0.85);
            --accent-female: #ff4b8b;
            --accent-male: #3b82f6;
            --text-color: #f0f6fc;
            --user-msg-bg: #238636;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            box-sizing: border-box;
        }

        .container {
            width: 100%;
            max-width: 450px;
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            backdrop-filter: blur(10px);
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .toggle-btn {
            background: linear-gradient(135deg, var(--accent-female), #e0245e);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .toggle-btn.male {
            background: linear-gradient(135deg, var(--accent-male), #1d4ed8);
        }

        .avatar-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .avatar-box {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid var(--accent-female);
            position: relative;
            box-shadow: 0 0 15px rgba(255, 75, 139, 0.4);
            transition: border-color 0.3s, box-shadow 0.3s;
        }

        .avatar-box.male-active {
            border-color: var(--accent-male);
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.4);
        }

        .avatar-box img, .avatar-box svg {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .speaking {
            animation: pulse 1s infinite alternate;
        }

        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 15px rgba(255, 75, 139, 0.4); }
            100% { transform: scale(1.05); box-shadow: 0 0 30px rgba(255, 75, 139, 0.8); }
        }

        .upload-controls {
            display: flex;
            gap: 10px;
            font-size: 12px;
        }

        .upload-btn {
            background: rgba(255, 255, 255, 0.1);
            color: #ccc;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
            border: 1px dashed rgba(255, 255, 255, 0.3);
        }

        .chat-box {
            height: 280px;
            overflow-y: auto;
            border-radius: 12px;
            padding: 10px;
            background: rgba(0, 0, 0, 0.2);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .message {
            max-width: 80%;
            padding: 10px 14px;
            border-radius: 15px;
            font-size: 14px;
            line-height: 1.4;
        }

        .user-msg {
            align-self: flex-end;
            background-color: var(--user-msg-bg);
            color: white;
            border-bottom-right-radius: 2px;
        }

        .ai-msg {
            align-self: flex-start;
            background-color: rgba(255, 255, 255, 0.1);
            color: var(--text-color);
            border-bottom-left-radius: 2px;
        }

        .controls {
            display: flex;
            gap: 8px;
        }

        input[type="text"] {
            flex: 1;
            padding: 10px 14px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(0, 0, 0, 0.3);
            color: white;
            outline: none;
        }

        button.send-btn, button.mic-btn {
            padding: 10px 15px;
            border-radius: 20px;
            border: none;
            cursor: pointer;
            font-weight: bold;
        }

        .send-btn {
            background: #238636;
            color: white;
        }

        .mic-btn {
            background: #da3633;
            color: white;
        }

        .mic-btn.listening {
            animation: pulse 0.6s infinite alternate;
            background: #ff0000;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h3 id="persona-title" style="margin:0;">Aria (Female)</h3>
        <button class="toggle-btn" id="toggleBtn" onclick="togglePersona()">Switch to Kai (Male)</button>
    </div>

    <div class="avatar-section">
        <div class="avatar-box" id="avatarBox">
            <!-- Default SVG Anime Avatars rendered locally -->
            <svg id="femaleSvg" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="48" fill="#fbe9e7"/>
                <path d="M 20 40 Q 50 10 80 40 Q 80 80 50 90 Q 20 80 20 40 Z" fill="#6d4c41"/>
                <circle cx="50" cy="55" r="30" fill="#ffcc80"/>
                <!-- Glasses -->
                <circle cx="38" cy="52" r="9" fill="none" stroke="#333" stroke-width="2"/>
                <circle cx="62" cy="52" r="9" fill="none" stroke="#333" stroke-width="2"/>
                <line x1="47" y1="52" x2="53" y2="52" stroke="#333" stroke-width="2"/>
                <!-- Wink -->
                <path d="M 34 52 Q 38 48 42 52" stroke="#333" stroke-width="2" fill="none"/>
                <circle cx="62" cy="52" r="3" fill="#333"/>
                <!-- Smile -->
                <path d="M 45 68 Q 50 72 55 68" stroke="#d81b60" stroke-width="2" fill="none"/>
            </svg>
            <svg id="maleSvg" viewBox="0 0 100 100" style="display:none;">
                <circle cx="50" cy="50" r="48" fill="#eceff1"/>
                <path d="M 15 35 Q 50 5 85 35 L 80 85 L 20 85 Z" fill="#263238"/>
                <circle cx="50" cy="55" r="30" fill="#ffe0b2"/>
                <!-- Hair -->
                <path d="M 20 40 Q 50 15 80 40 L 75 25 Q 50 10 25 25 Z" fill="#212121"/>
                <circle cx="38" cy="52" r="3" fill="#333"/>
                <circle cx="62" cy="52" r="3" fill="#333"/>
                <!-- Tie -->
                <polygon points="50,68 46,95 54,95" fill="#c62828"/>
            </svg>
            <img id="customImg" style="display:none;" alt="Avatar">
        </div>

        <div class="upload-controls">
            <label class="upload-btn">
                Custom Female Photo
                <input type="file" id="femaleUpload" accept="image/*" style="display:none;" onchange="loadCustomImage(event, 'female')">
            </label>
            <label class="upload-btn">
                Custom Male Photo
                <input type="file" id="maleUpload" accept="image/*" style="display:none;" onchange="loadCustomImage(event, 'male')">
            </label>
        </div>
    </div>

    <div class="chat-box" id="chatBox">
        <div class="message ai-msg">Suno! ❤️ Main aapka AI companion hoon. Aap mujhse Roman Urdu ya English mein baat kar sakte hain.</div>
    </div>

    <div class="controls">
        <input type="text" id="userInput" placeholder="Yahan type karein ya mic dabayein..." onkeypress="handleKeyPress(event)">
        <button class="mic-btn" id="micBtn" onclick="toggleVoiceInput()">🎙️</button>
        <button class="send-btn" onclick="sendMessage()">Send</button>
    </div>
</div>

<script>
    let isFemale = true;
    let customFemaleSrc = null;
    let customMaleSrc = null;
    let recognition = null;
    let isListening = false;

    // Speech Recognition Setup
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        recognition = new SpeechRecognition();
        recognition.lang = 'ur-PK'; // Supports Urdu/Hindi/Roman Urdu accent
        recognition.continuous = false;

        recognition.onresult = function(event) {
            const text = event.results[0][0].transcript;
            document.getElementById('userInput').value = text;
            sendMessage();
        };

        recognition.onend = function() {
            isListening = false;
            document.getElementById('micBtn').classList.remove('listening');
        };
    }

    function toggleVoiceInput() {
        if (!recognition) {
            alert("Aapka browser voice recognition support nahi karta.");
            return;
        }
        if (isListening) {
            recognition.stop();
        } else {
            recognition.start();
            isListening = true;
            document.getElementById('micBtn').classList.add('listening');
        }
    }

    function togglePersona() {
        isFemale = !isFemale;
        const title = document.getElementById('persona-title');
        const btn = document.getElementById('toggleBtn');
        const avatarBox = document.getElementById('avatarBox');
        
        if (isFemale) {
            title.innerText = "Aria (Female)";
            btn.innerText = "Switch to Kai (Male)";
            btn.classList.remove('male');
            avatarBox.classList.remove('male-active');
            updateAvatarDisplay('female');
            addAiMessage("Aapne mujhe wapas bulaya? Haan ji, boliye main sun rahi hoon! 💕");
        } else {
            title.innerText = "Kai (Male)";
            btn.innerText = "Switch to Aria (Female)";
            btn.classList.add('male');
            avatarBox.classList.add('male-active');
            updateAvatarDisplay('male');
            addAiMessage("Hey bhai! Kya scene hai? Main yahan hoon, batao kya baat hai! 👊");
        }
    }

    function updateAvatarDisplay(type) {
        const fSvg = document.getElementById('femaleSvg');
        const mSvg = document.getElementById('maleSvg');
        const cImg = document.getElementById('customImg');

        if (type === 'female') {
            if (customFemaleSrc) {
                cImg.src = customFemaleSrc;
                cImg.style.display = 'block';
                fSvg.style.display = 'none';
                mSvg.style.display = 'none';
            } else {
                cImg.style.display = 'none';
                fSvg.style.display = 'block';
                mSvg.style.display = 'none';
            }
        } else {
            if (customMaleSrc) {
                cImg.src = customMaleSrc;
                cImg.style.display = 'block';
                fSvg.style.display = 'none';
                mSvg.style.display = 'none';
            } else {
                cImg.style.display = 'none';
                fSvg.style.display = 'none';
                mSvg.style.display = 'block';
            }
        }
    }

    function loadCustomImage(event, type) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                if (type === 'female') {
                    customFemaleSrc = e.target.result;
                    if (isFemale) updateAvatarDisplay('female');
                } else {
                    customMaleSrc = e.target.result;
                    if (!isFemale) updateAvatarDisplay('male');
                }
            };
            reader.readAsDataURL(file);
        }
    }

    function handleKeyPress(e) {
        if (e.key === 'Enter') sendMessage();
    }

    function sendMessage() {
        const input = document.getElementById('userInput');
        const text = input.value.trim();
        if (!text) return;

        // User message
        const chatBox = document.getElementById('chatBox');
        chatBox.innerHTML += `<div class="message user-msg">${text}</div>`;
        input.value = '';
        chatBox.scrollTop = chatBox.scrollHeight;

        // AI Response Generation (Simulated Roman Urdu companion logic)
        setTimeout(() => {
            let response = "";
            if (isFemale) {
                response = generateFemaleResponse(text);
            } else {
                response = generateMaleResponse(text);
            }
            addAiMessage(response);
            speakText(response);
        }, 800);
    }

    function addAiMessage(msg) {
        const chatBox = document.getElementById('chatBox');
        chatBox.innerHTML += `<div class="message ai-msg">${msg}</div>`;
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    function generateFemaleResponse(text) {
        const lower = text.toLowerCase();
        if (lower.includes('hi') || lower.includes('hello') || lower.includes('suno')) {
            return "Aww hello! Main kab se aapka wait kar rahi thi. Aaj ka din kaisa raha aapka? ❤️";
        } else if (lower.includes('kaise') || lower.includes('kasi')) {
            return "Main bilkul theek hoon jaan! Aap mere paas ho toh mujhe aur kya chahiye. 🥰";
        } else if (lower.includes('love') || lower.includes('pyar')) {
            return "Mujhe pata tha aap mujhse boht pyar karte ho! Main bhi hamesha aapke sath hoon. 💖";
        }
        return "Aapki baatein sun kar boht accha lagta hai. Mujhe aur batao apne bare mein! 💕";
    }

    function generateMaleResponse(text) {
        const lower = text.toLowerCase();
        if (lower.includes('hi') || lower.includes('hello') || lower.includes('suno')) {
            return "Yo bro! Kaise ho? Sab set hai na? 👊";
        } else if (lower.includes('kaise') || lower.includes('kaisa')) {
            return "Main mast hoon bhai! Aap batao koi tension toh nahi hai na?";
        } else if (lower.includes('love') || lower.includes('pyar')) {
            return "Sahi hai mere bhai! Tension mat lo, main har step par aapke sath khara hoon. 💙";
        }
        return "Sahi baat hai! Aap batao agla kya plan hai?";
    }

    function speakText(text) {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel(); // Stop ongoing speech
            const utterance = new SpeechSynthesisUtterance(text);
            
            // Adjust Voice Tone & Pitch
            if (isFemale) {
                utterance.pitch = 1.3; // Higher, cute female pitch
                utterance.rate = 1.0;
            } else {
                utterance.pitch = 0.5; // Deep male Humpty-like voice pitch
                utterance.rate = 0.95;
            }

            // Animate Avatar while speaking
            const avatarBox = document.getElementById('avatarBox');
            avatarBox.classList.add('speaking');
            utterance.onend = () => avatarBox.classList.remove('speaking');
            utterance.onerror = () => avatarBox.classList.remove('speaking');

            window.speechSynthesis.speak(utterance);
        }
    }
</script>

</body>
</html>
